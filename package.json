{
  "name": "nsfw-api",
  "version": "2.0.0",
  "description": "Self-hosted image moderation API (nudity, weapons, gore, drugs) in Rust, ready for Railway.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^22.18.0"
  },
  "scripts": {
    "prepare-models": "node scripts/prepare-nsfw.ts && node scripts/prepare-clip.ts",
    "dev": "cargo run --release",
    "typecheck": "tsc",
    "test": "cargo test && cargo build --release && tsc && vitest run",
    "smoke": "node scripts/smoke.ts"
  },
  "devDependencies": {
    "@huggingface/transformers": "4.3.1",
    "@types/node": "22.20.5",
    "nsfwjs": "4.4.0",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
